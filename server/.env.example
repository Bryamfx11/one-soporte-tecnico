# Copiar a .env y ajustar. JWT_SECRET es obligatorio en producción.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000
